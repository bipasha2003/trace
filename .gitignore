# ============================================
# TRACE — Root .gitignore
# Full-stack monorepo (Python + Node)
# ============================================

# ── Environment Variables ───────────────────
.env
!.env.example

# ── Python ──────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
eggs/
*.egg
.venv/
venv/
ENV/

# ── Node ────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── IDE ─────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── OS ──────────────────────────────────────
.DS_Store
Thumbs.db
.directory

# ── Database ────────────────────────────────
*.db
*.sqlite3

# ── Logs ────────────────────────────────────
*.log

# ── Runtime / PID files ─────────────────────
.trace_pids
*.pid

# ── Docker ──────────────────────────────────
docker-compose.override.yml

# ── Testing ─────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
