# ============================================
# TRACE — Environment (Example)
# Copy to .env. This is the ONLY env file: Docker Compose, start.sh, the
# backend and the Vite config all read it. There is no backend/.env.
# ============================================

# Environment — local | production
# production: served publicly at PRODUCTION_URL through the Cloudflare tunnel.
# See README → Production. Read by start.sh, Docker Compose and the backend.
APP_ENV=local
PRODUCTION_URL=
CLOUDFLARE_TUNNEL_TOKEN=

# PostgreSQL
POSTGRES_DB=trace_db
POSTGRES_USER=trace_user
POSTGRES_PASSWORD=trace_password

# Port Mappings (host:container)
DB_PORT=5433
REDIS_PORT=6379
API_PORT=8000
FRONTEND_PORT=5173

# pgAdmin
PGADMIN_EMAIL=admin@trace.com
PGADMIN_PASSWORD=admin123
PGADMIN_PORT=5050

# Mailpit
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# MinIO
MINIO_ROOT_USER=trace_minio
MINIO_ROOT_PASSWORD=trace_minio_secret
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ── Backend application ─────────────────────────────────────
# DATABASE_URL, REDIS_URL, MINIO_ENDPOINT / credentials and SMTP_PORT are derived
# from the keys above (backend/app/config.py). Set one only to override it.
# Production refuses DEBUG=true and a placeholder JWT secret. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
DEBUG=true
JWT_SECRET_KEY=your-super-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480
SMTP_FROM=noreply@trace.com
MINIO_BUCKET=trace-uploads
# Encrypts secret settings (the GitHub token, …) saved in Admin → Configuration.
# Required in production. Changing it makes saved secrets unreadable — re-enter them.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SETTINGS_ENCRYPTION_KEY=

# AI provider — fallback only; Admin → Configuration overrides it
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# GitHub — fallback only; Admin → Configuration overrides it (docs/CORE.md §4.1).
# TRACE creates every project's repository (always public) under this organization.
# Personal accounts are not supported.
GITHUB_OWNER=
# Fine-grained token for that organization: Administration, Contents and Issues
# read/write, Metadata read.
GITHUB_TOKEN=
# Name and email on the commits TRACE makes into project repos (generated docs)
GITHUB_COMMITTER_NAME=
GITHUB_COMMITTER_EMAIL=
