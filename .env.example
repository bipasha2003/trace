# ============================================
# TRACE — Root Environment Variables (Example)
# Copy to .env and customize as needed
# ============================================

# PostgreSQL
POSTGRES_DB=trace_db
POSTGRES_USER=trace_user
POSTGRES_PASSWORD=trace_password

# Port Mappings (host:container)
DB_PORT=5432
REDIS_PORT=6379
API_PORT=8000
FRONTEND_PORT=5173

# pgAdmin
PGADMIN_EMAIL=admin@trace.com
PGADMIN_PASSWORD=admin123
PGADMIN_PORT=5050

# Mailpit
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# MinIO
MINIO_ROOT_USER=trace_minio
MINIO_ROOT_PASSWORD=trace_minio_secret
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
