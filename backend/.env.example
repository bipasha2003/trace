# ============================================
# TRACE - Environment Configuration
# ============================================

# Application
APP_NAME=TRACE
APP_VERSION=1.0.0
DEBUG=true

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://trace_user:trace_password@localhost:5432/trace_db
DATABASE_ECHO=false

# JWT Authentication
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Redis (for Celery)
REDIS_URL=redis://localhost:6379/0

# SendGrid (Email)
SENDGRID_API_KEY=your-sendgrid-api-key
ADMIN_EMAIL=admin@trace.com

# Geo-Fence Defaults
DEFAULT_GEO_FENCE_RADIUS_METERS=200
