# ============================================
# TRACE - Environment Configuration
# ============================================

# Application
APP_NAME=TRACE
APP_VERSION=1.0.0
DEBUG=true

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://trace_user:trace_password@localhost:5432/trace_db
DATABASE_ECHO=false

# JWT Authentication
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Redis (for Celery)
REDIS_URL=redis://localhost:6379/0

# SendGrid (Email)
SENDGRID_API_KEY=your-sendgrid-api-key
ADMIN_EMAIL=admin@trace.com

# Platform Admin Seeding
PLATFORM_ADMIN_EMAIL=platformadmin@trace.com
PLATFORM_ADMIN_USERNAME=platform_admin
PLATFORM_ADMIN_PASSWORD=PlatformAdmin@123
PLATFORM_ADMIN_NAME=Platform Administrator

# Geo-Fence Defaults
DEFAULT_GEO_FENCE_RADIUS_METERS=200

# MinIO (S3-Compatible Object Storage)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=trace_minio
MINIO_SECRET_KEY=trace_minio_secret
MINIO_BUCKET=trace-uploads
MINIO_SECURE=false

# Mailpit (SMTP)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@trace.com

# OpenAI SDK (LLM)
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
